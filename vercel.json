{
  "version": 2,
  "builds": [
    { "src": "api/main.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/main.py" },
    { "src": "/(.*\\.(js|css|png|jpg|ico|svg|woff|woff2))", "dest": "public/$1" },
    { "src": "/(.*)", "dest": "public/index.html" }
  ],
  "env": {
    "RAG_LLM_MODE": "none",
    "PYTHONPATH": "."
  }
}
