# Copy this file to .env and fill in your values.
# The system runs without an API key (extractive fallback, llm_mode=none).

# Backend URL used by the Streamlit frontend
BACKEND_URL=http://localhost:8000

# LLM mode: none | api | local
RAG_LLM_MODE=none

# Free API tier (only needed if RAG_LLM_MODE=api)
RAG_API_BASE=https://7api.st
RAG_API_MODEL=Grok 4.7
RAG_API_KEY=sk-c2de9b1d100fdcd2086e98a4e2ff1ee59a8a676a3bdf3eb1


# Local model (only needed if RAG_LLM_MODE=local), runs on CPU
RAG_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct
